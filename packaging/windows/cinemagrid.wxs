<?xml version="1.0" encoding="utf-8"?>
<!--
  CinemaGrid MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build cinemagrid.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="CinemaGrid"
      Manufacturer="CinemaGrid"
      Version="$(var.Version)"
      UpgradeCode="31E6FB14-9DBC-41DD-B24B-26B71FB31B62"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="CinemaGrid video editor" Manufacturer="CinemaGrid" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of CinemaGrid is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CinemagridIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CinemagridIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/BORAVELLISARIKAREDDY/cinemagrid" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/BORAVELLISARIKAREDDY/cinemagrid/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/BORAVELLISARIKAREDDY/cinemagrid/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CinemaGrid" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="CinemaGrid" Level="1">
      <ComponentGroupRef Id="CinemagridFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="CinemagridFiles" Directory="INSTALLFOLDER">
      <Component Id="CinemagridApp" Guid="15933017-925B-4963-8992-52000EB26AAA">
        <File Id="CinemagridExe" Source="$(var.BinDir)\cinemagrid.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="CinemaGrid"
              Description="CinemaGrid video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CinemagridIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\cinemagrid.exe" Value="[#CinemagridExe]" Type="string" />
      </Component>

      <Component Id="CinemagridCli">
        <File Id="CinemagridCliExe" Source="$(var.BinDir)\cinemagrid-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
